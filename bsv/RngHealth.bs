package RngHealth where

-- NIST SP 800-90B 第 4.4 节的两项持续健康测试，给二值噪声源（一拍一位）用。截止值都是编译期常数：
-- 熵估计以十分之一位为单位写在清单里（hTenths），这里算出来。
--   重复计数测试（4.4.1）：C = 1 + ceil(-log2(α) / H)，α = 2^-20
--   自适应比例测试（4.4.2）：二值源窗口 W = 1024，C 取表 2。p = 2^-H 只有 H = 1 是有理数，
--   那一行能用整数把二项分布的临界值精确算出来：编译时照算一遍，与表里的 589 对不上就不让生成，
--   抄错表这一类错在这里拦住。

aptWindow :: Integer
aptWindow = 1024

rctCutoff :: Integer -> Integer
rctCutoff h = 1 + (200 + h - 1) `div` h

-- 表 2 二值源一栏
aptTable :: Integer -> Integer
aptTable 2  = 941
aptTable 4  = 840
aptTable 6  = 748
aptTable 8  = 664
aptTable 10 = 589
aptTable h  = error ("RNG: SP 800-90B table 2 has no binary cutoff for H = " +++ integerToString h +++ "/10")

-- Binomial(w, 1/2) 的累积概率第一次不小于 1 - 2^-20 的 k，再加一（表 2 脚注的 1 + CRITBINOM）。
-- 累积和乘 2^20 与 (2^20 - 1) · 2^w 比，全程整数
aptExactHalf :: Integer -> Integer
aptExactHalf w =
  let target :: Integer
      target = (2 ** 20 - 1) * 2 ** w
      go :: Integer -> Integer -> Integer -> Integer
      go k c s = let s' = s + c
                 in  if s' * 2 ** 20 >= target then k + 1
                     else go (k + 1) ((c * (w - k)) `div` (k + 1)) s'
  in  go 0 1 0

aptCutoff :: Integer -> Integer
aptCutoff h =
  if h == 10 && aptExactHalf aptWindow /= aptTable 10
  then error "RNG: the exact binomial cutoff for H = 1 does not match SP 800-90B table 2"
  else aptTable h
